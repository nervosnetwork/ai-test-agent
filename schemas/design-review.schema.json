{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1,
      "const": "2.0"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "input_fingerprint": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9a-f]{64}$"
    },
    "reviewer": {
      "type": "object",
      "properties": {
        "session": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "isolation": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "transport_contract_tested",
            "host_attested",
            "isolation_unverified"
          ]
        }
      },
      "required": [
        "session",
        "model",
        "isolation"
      ],
      "additionalProperties": false
    },
    "acknowledgements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "spec_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          }
        },
        "required": [
          "case_id",
          "spec_refs"
        ],
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "finding_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^F-[0-9]{2,}$"
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "basis": {
            "type": "string",
            "minLength": 1
          },
          "suggestion": {
            "type": "string",
            "minLength": 1
          },
          "impact": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "finding_id",
          "location",
          "basis",
          "suggestion",
          "impact"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "scope",
    "input_fingerprint",
    "reviewer",
    "acknowledgements",
    "findings"
  ],
  "additionalProperties": false
}
