{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1,
      "const": "2.0"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "input_fingerprint": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9a-f]{64}$"
    },
    "reviewer": {
      "type": "object",
      "properties": {
        "session": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "isolation": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "contract_tested",
            "isolation_unverified"
          ]
        }
      },
      "required": [
        "session",
        "model",
        "isolation"
      ],
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "location": {
            "type": "string",
            "minLength": 1
          },
          "basis": {
            "type": "string",
            "minLength": 1
          },
          "suggestion": {
            "type": "string",
            "minLength": 1
          },
          "impact": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "accepted",
              "duplicate",
              "not_applicable",
              "needs_decision"
            ]
          },
          "response": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "location",
          "basis",
          "suggestion",
          "impact",
          "disposition",
          "response"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "scope",
    "input_fingerprint",
    "reviewer",
    "findings"
  ],
  "additionalProperties": false
}
