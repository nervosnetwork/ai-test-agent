{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.0"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "input_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "responses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^F-[0-9]{2,}$"
          },
          "disposition": {
            "type": "string",
            "enum": [
              "accepted",
              "duplicate",
              "not_applicable",
              "needs_decision"
            ]
          },
          "response": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "finding_id",
          "disposition",
          "response"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "scope",
    "input_fingerprint",
    "responses"
  ],
  "additionalProperties": false
}
