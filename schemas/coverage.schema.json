{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1,
      "const": "2.0"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "input_fingerprint": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9a-f]{64}$"
    },
    "reviewer": {
      "type": "object",
      "properties": {
        "session": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "isolation": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "contract_tested",
            "isolation_unverified"
          ]
        }
      },
      "required": [
        "session",
        "model",
        "isolation"
      ],
      "additionalProperties": false
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*-\\d{2,}$"
          },
          "spec_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "coverage": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "covered",
              "partial",
              "missing",
              "uncertain"
            ]
          },
          "bindings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "file": {
                  "type": "string",
                  "minLength": 1
                },
                "symbol": {
                  "type": "string",
                  "minLength": 1
                },
                "runner_selector": {
                  "type": "string",
                  "minLength": 1
                },
                "parameters": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "setup": {
                  "type": "string",
                  "minLength": 1
                },
                "trigger": {
                  "type": "string",
                  "minLength": 1
                },
                "observation": {
                  "type": "string",
                  "minLength": 1
                },
                "assertions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "file": {
                        "type": "string",
                        "minLength": 1
                      },
                      "symbol": {
                        "type": "string",
                        "minLength": 1
                      },
                      "text": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "file",
                      "symbol",
                      "text"
                    ],
                    "additionalProperties": false
                  }
                },
                "missing": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "file",
                "symbol",
                "runner_selector",
                "parameters",
                "setup",
                "trigger",
                "observation",
                "assertions",
                "missing"
              ],
              "additionalProperties": false
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "case_id",
          "spec_refs",
          "coverage",
          "bindings",
          "limitations"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "scope",
    "input_fingerprint",
    "reviewer",
    "cases"
  ],
  "additionalProperties": false
}
